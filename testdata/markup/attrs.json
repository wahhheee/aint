{
  "description": "属性：只认 name=\"值\"；名称为字母或下划线开头的 [A-Za-z0-9_-]；单引号、无引号的值、不合法的名称、杂字忽略；同名取第一个；值原样保留；引号内的 > 不结束标签",
  "tags": ["say", "scene", "cg", "fx", "gold"],
  "cases": [
    {
      "name": "属性值用双引号",
      "input": "<say who=\"林舟\" mood=\"平静\">话</say>",
      "ast": [["p", ["<say>", {"who": "林舟", "mood": "平静"}, "话"]]]
    },
    {
      "name": "没有属性的标签",
      "input": "<fx>字</fx>",
      "ast": [["p", ["<fx>", "字"]]]
    },
    {
      "name": "等号两侧可有空白",
      "input": "<say who = \"林舟\">话</say>",
      "ast": [["p", ["<say>", {"who": "林舟"}, "话"]]]
    },
    {
      "name": "单引号与无引号的值忽略，标签照常成立",
      "input": "<say who='lin' mood=平静 x=1 y=\"2\">话</say>",
      "ast": [["p", ["<say>", {"y": "2"}, "话"]]]
    },
    {
      "name": "同名属性取第一个",
      "input": "<say who=\"甲\" who=\"乙\">话</say>",
      "ast": [["p", ["<say>", {"who": "甲"}, "话"]]]
    },
    {
      "name": "不合法的属性名连同其值忽略",
      "input": "<say -x=\"1\" 1y=\"2\" _z=\"3\" A-b=\"4\">话</say>",
      "ast": [["p", ["<say>", {"_z": "3", "A-b": "4"}, "话"]]]
    },
    {
      "name": "属性名区分大小写",
      "input": "<say Who=\"林舟\">话</say>",
      "ast": [["p", ["<say>", {"Who": "林舟"}, "话"]]],
      "plain": "话"
    },
    {
      "name": "空值",
      "input": "<scene bg=\"\" title=\"序章\"/>",
      "ast": [["scene", {"bg": "", "title": "序章"}]],
      "plain": "序章"
    },
    {
      "name": "值中可以有 >、/、< 与空白",
      "input": "<cg src=\"a\" caption=\"1 > 0 / <好>  \"/>",
      "ast": [["cg", {"src": "a", "caption": "1 > 0 / <好>  "}]]
    },
    {
      "name": "值原样保留，不解码实体与反斜杠",
      "input": "<say who=\"&amp;\\n\\*\">话</say>",
      "ast": [["p", ["<say>", {"who": "&amp;\\n\\*"}, "话"]]]
    },
    {
      "name": "值中的中文引号",
      "input": "<say who=\"「老陈」\">……</say>",
      "ast": [["p", ["<say>", {"who": "「老陈」"}, "……"]]],
      "plain": "「老陈」：……"
    },
    {
      "name": "属性之间可以没有空白",
      "input": "<say who=\"甲\"mood=\"乙\">话</say>",
      "ast": [["p", ["<say>", {"who": "甲", "mood": "乙"}, "话"]]]
    },
    {
      "name": "自闭合的 / 前后可有空白",
      "input": "<gold x=\"1\" /><gold y=\"2\"/ >",
      "ast": [["p", ["<gold>", {"x": "1"}], ["<gold>", {"y": "2"}]]]
    },
    {
      "name": "值以 / 结尾不是自闭合",
      "input": "<gold x=\"a/\">甲</gold>",
      "ast": [["p", ["<gold>", {"x": "a/"}, "甲"]]]
    },
    {
      "name": "游离的引号串与杂字忽略",
      "input": "<say \"旁白\" who=\"甲\" ! ?>话</say>",
      "ast": [["p", ["<say>", {"who": "甲"}, "话"]]]
    },
    {
      "name": "标签内的空白可以是全角空格与制表符",
      "input": "<say　who=\"甲\"\tmood=\"乙\">话</say>",
      "ast": [["p", ["<say>", {"who": "甲", "mood": "乙"}, "话"]]]
    },
    {
      "name": "引号没有配对时标签不成立，按文字显示",
      "input": "<say who=\"甲>话</say>",
      "ast": [["p", "<say who=\"甲>话"]]
    },
    {
      "name": "白名单外的标签保留属性原文",
      "input": "<note a='1' b=\"2\">注</note>",
      "ast": [["p", ["raw", "<note a='1' b=\"2\">"], "注", ["raw", "</note>"]]]
    }
  ]
}
