{
  "description": "转义与特殊字符：反斜杠只转义 \\ * < > -（得到字符本身），其他字符前的反斜杠保留；HTML 实体不解码；不构成标签的 < 按文字显示；全角符号、中文标点、Emoji、零宽字符照常显示",
  "tags": ["gold", "say"],
  "cases": [
    {
      "name": "转义星号",
      "input": "\\*不是强调\\*",
      "ast": [["p", "*不是强调*"]],
      "plain": "*不是强调*"
    },
    {
      "name": "转义反斜杠",
      "input": "a\\\\b",
      "ast": [["p", "a\\b"]]
    },
    {
      "name": "转义 <：白名单中的标签也按文字显示",
      "input": "\\<gold>不是标签\\</gold>",
      "ast": [["p", "<gold>不是标签</gold>"]]
    },
    {
      "name": "行首的 \\> 不是引用",
      "input": "\\> 不是引用",
      "ast": [["p", "> 不是引用"]]
    },
    {
      "name": "\\--- 不是场景分隔",
      "input": ["\\---", "\\-\\-\\-", "\\***"],
      "ast": [["p", "---"], ["p", "---"], ["p", "***"]]
    },
    {
      "name": "其他字符前的反斜杠保留",
      "input": "C:\\Users\\林舟\\n \\「 \\a",
      "ast": [["p", "C:\\Users\\林舟\\n \\「 \\a"]]
    },
    {
      "name": "行尾的反斜杠保留",
      "input": ["结尾\\", "下一行"],
      "ast": [["p", "结尾\\"], ["p", "下一行"]]
    },
    {
      "name": "转义的星号不算结束符",
      "input": "*强调\\*",
      "ast": [["p", "*强调*"]]
    },
    {
      "name": "强调中的转义星号",
      "input": "*a\\*b*",
      "ast": [["p", ["*", "a*b"]]]
    },
    {
      "name": "三个反斜杠：转义的反斜杠 + 转义的星号",
      "input": "\\\\\\*",
      "ast": [["p", "\\*"]]
    },
    {
      "name": "HTML 实体不解码",
      "input": "&lt;gold&gt; &amp; &nbsp; &#20320;",
      "ast": [["p", "&lt;gold&gt; &amp; &nbsp; &#20320;"]]
    },
    {
      "name": "比较符号与箭头",
      "input": "1 < 2，3>2，a<b，<3，<-，<=>，<<>>",
      "ast": [["p", "1 < 2，3>2，a<b，<3，<-，<=>，<<>>"]]
    },
    {
      "name": "像标签的未知内容按原文显示",
      "input": "x<y>z",
      "ast": [["p", "x", ["raw", "<y>"], "z"]]
    },
    {
      "name": "全角符号不是标记",
      "input": ["＜gold＞全角＜／gold＞，＊全角星号＊", "＞全角引用", "＊＊＊", "－－－"],
      "ast": [["p", "＜gold＞全角＜／gold＞，＊全角星号＊"], ["p", "＞全角引用"], ["p", "＊＊＊"], ["p", "－－－"]]
    },
    {
      "name": "中文标点",
      "input": "「你来了。」『嗯。』——《海雾》……〈序〉【注】～・？！",
      "ast": [["p", "「你来了。」『嗯。』——《海雾》……〈序〉【注】～・？！"]]
    },
    {
      "name": "中文破折号与省略号的行不是场景分隔",
      "input": ["——", "……", "———"],
      "ast": [["p", "——"], ["p", "……"], ["p", "———"]]
    },
    {
      "name": "Emoji、扩展区汉字与组合字符",
      "input": "🌊𠀀é👨‍👩‍👧<gold>🔥</gold>",
      "ast": [["p", "🌊𠀀é👨‍👩‍👧", ["<gold>", "🔥"]]]
    },
    {
      "name": "零宽字符与软连字符不是空白，保留",
      "input": "\u200b正文\u00ad中\u200d文\ufeff\u200b",
      "ast": [["p", "\u200b正文\u00ad中\u200d文\ufeff\u200b"]]
    },
    {
      "name": "行内的 Unicode 行分隔符、单独的回车与制表符不分段",
      "input": "\u2028甲\u2028乙\r丙\t丁\u2029",
      "ast": [["p", "甲\u2028乙\r丙\t丁"]]
    },
    {
      "name": "英文引号",
      "input": "他说\"走\"，又说'停'",
      "ast": [["p", "他说\"走\"，又说'停'"]]
    }
  ]
}
