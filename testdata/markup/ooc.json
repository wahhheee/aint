{
  "description": "场外 <ooc>（D-30）：行首的 <ooc> 开始可以跨行的场外块，到第一个未转义的 </ooc> 为止（没有时到文末）；块内按正文规则解析、不再识别 <ooc>；</ooc> 之后的文字按新的一行解析；空的场外块不显示；不在行首的 <ooc> 是行内标签；场外内容不进入纯文本",
  "tags": ["ooc", "gold", "say", "scene"],
  "cases": [
    {
      "name": "可以跨行，内部按正文规则分段；块后的正文照常解析",
      "input": ["<ooc>好的，节奏放慢一些。", "", "<gold>线索</gold>会更隐蔽。</ooc>", "雾又浓了。"],
      "ast": [["ooc", ["p", "好的，节奏放慢一些。"], ["p", ["<gold>", "线索"], "会更隐蔽。"]], ["p", "雾又浓了。"]],
      "plain": "雾又浓了。"
    },
    {
      "name": "单行场外块",
      "input": "<ooc>收到，接下来节奏放慢。</ooc>",
      "ast": [["ooc", ["p", "收到，接下来节奏放慢。"]]],
      "plain": ""
    },
    {
      "name": "</ooc> 之后的文字另起一段",
      "input": "<ooc>好。</ooc>雨停了。",
      "ast": [["ooc", ["p", "好。"]], ["p", "雨停了。"]],
      "plain": "雨停了。"
    },
    {
      "name": "</ooc> 之后的文字按新的一行解析",
      "input": "<ooc>好。</ooc>> 引文",
      "ast": [["ooc", ["p", "好。"]], ["quote", "引文"]]
    },
    {
      "name": "<ooc> 与 </ooc> 各占一行",
      "input": ["<ooc>", "好的。", "</ooc>", "雨停了。"],
      "ast": [["ooc", ["p", "好的。"]], ["p", "雨停了。"]]
    },
    {
      "name": "行首空白之后的 <ooc> 也开始场外块",
      "input": "　　<ooc>场外</ooc>",
      "ast": [["ooc", ["p", "场外"]]]
    },
    {
      "name": "开始标签可以带属性",
      "input": "<ooc x=\"1\">场外</ooc >",
      "ast": [["ooc", ["p", "场外"]]]
    },
    {
      "name": "多个场外块",
      "input": ["正文一。", "<ooc>甲</ooc>", "正文二。", "<ooc>乙</ooc><ooc>丙</ooc>"],
      "ast": [["p", "正文一。"], ["ooc", ["p", "甲"]], ["p", "正文二。"], ["ooc", ["p", "乙"]], ["ooc", ["p", "丙"]]],
      "plain": "正文一。\n正文二。"
    },
    {
      "name": "场外块内不再识别 <ooc>",
      "input": ["<ooc>你说的", "<ooc>是这个吗", "</ooc>正文"],
      "ast": [["ooc", ["p", "你说的"], ["p", ["raw", "<ooc>"], "是这个吗"]], ["p", "正文"]],
      "plain": "正文"
    },
    {
      "name": "场外块内的引用、分隔与段首场景照常解析",
      "input": ["<ooc>> 引用", "---", "<scene bg=\"a\" title=\"序\"/>说明</ooc>"],
      "ast": [["ooc", ["quote", "引用"], ["divider"], ["scene", {"bg": "a", "title": "序"}], ["p", "说明"]]],
      "plain": ""
    },
    {
      "name": "尚未写到 </ooc> 时到文末都属于场外块",
      "input": ["雨停了。", "<ooc>场外", "跨行回应"],
      "ast": [["p", "雨停了。"], ["ooc", ["p", "场外"], ["p", "跨行回应"]]],
      "plain": "雨停了。"
    },
    {
      "name": "空的场外块不显示",
      "input": ["<ooc></ooc>后文", "<ooc>", "</ooc>", "<ooc>　"],
      "ast": [["p", "后文"]]
    },
    {
      "name": "转义的 </ooc> 不结束场外块",
      "input": "<ooc>写法是 \\</ooc> 这样</ooc>",
      "ast": [["ooc", ["p", "写法是 </ooc> 这样"]]]
    },
    {
      "name": "两个反斜杠之后的 </ooc> 结束场外块",
      "input": "<ooc>路径 \\\\</ooc>正文",
      "ast": [["ooc", ["p", "路径 \\"]], ["p", "正文"]]
    },
    {
      "name": "不完整的 </ooc 不结束场外块",
      "input": ["<ooc>场外</ooc", "仍是场外</ooc>"],
      "ast": [["ooc", ["p", "场外</ooc"], ["p", "仍是场外"]]]
    },
    {
      "name": "名称更长的 </oocx> 不结束场外块",
      "input": "<ooc>甲</oocx>乙</ooc>",
      "ast": [["ooc", ["p", "甲", ["raw", "</oocx>"], "乙"]]]
    },
    {
      "name": "转义的行首 <ooc> 不开始场外块",
      "input": "\\<ooc>不是场外",
      "ast": [["p", "<ooc>不是场外"]]
    },
    {
      "name": "自闭合的 <ooc/> 不开始场外块",
      "input": "<ooc/>正文",
      "ast": [["p", ["<ooc>"], "正文"]],
      "plain": "正文"
    },
    {
      "name": "不在行首的 <ooc> 是行内标签",
      "input": "他点点头。<ooc>（场外：好）</ooc>继续。",
      "ast": [["p", "他点点头。", ["<ooc>", "（场外：好）"], "继续。"]],
      "plain": "他点点头。继续。"
    },
    {
      "name": "行内 <ooc> 在段落结束时自动闭合",
      "input": ["他说<ooc>场外", "正文</ooc>"],
      "ast": [["p", "他说", ["<ooc>", "场外"]], ["p", "正文"]],
      "plain": "他说\n正文"
    },
    {
      "name": "多余的 </ooc> 忽略",
      "input": "正文</ooc>",
      "ast": [["p", "正文"]]
    },
    {
      "name": "场外块内的台词也不进入纯文本",
      "input": ["<ooc><say who=\"林舟\">「我会注意。」</say></ooc>", "<say who=\"林舟\">「走吧。」</say>"],
      "ast": [["ooc", ["p", ["<say>", {"who": "林舟"}, "「我会注意。」"]]], ["p", ["<say>", {"who": "林舟"}, "「走吧。」"]]],
      "plain": "林舟：「走吧。」"
    },
    {
      "name": "未启用时按原文显示",
      "tags": ["gold"],
      "input": ["<ooc>场外", "</ooc>"],
      "ast": [["p", ["raw", "<ooc>"], "场外"], ["p", ["raw", "</ooc>"]]],
      "plain": "<ooc>场外\n</ooc>"
    }
  ]
}
