      "ast": [["p", "雾很浓。"], ["p", "他说。"]]
    },
    {
      "name": "BOM 与 NEL 也算空白",
      "input": "\ufeff第一段\u0085\n\u0085第二段",
      "ast": [["p", "第一段"], ["p", "第二段"]]
    },
    {
      "name": "段内空白保留",
      "input": "他停了停，  又说：\u3000「走吧。」",
      "ast": [["p", "他停了停，  又说：\u3000「走吧。」"]]
    },
    {
      "name": "空输入",
      "input": "",
