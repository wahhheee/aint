{
  "$id": "https://raw.githubusercontent.com/wahhheee/aint/main/schemas/work.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "编辑器补全与结构校验；完整校验请运行 aint work validate。未知字段由运行时报告警告。",
  "properties": {
    "authors": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "changelog": {
      "type": "string"
    },
    "content_rating": {
      "enum": [
        "general",
        "teen",
        "mature"
      ],
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "docs": {
      "additionalProperties": true,
      "properties": {
        "default_load": {
          "enum": [
            "always",
            "index",
            "none"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "engine": {
      "type": "string"
    },
    "features": {
      "additionalProperties": true,
      "properties": {
        "dice": {
          "type": "boolean"
        },
        "force_choices": {
          "type": "boolean"
        },
        "free_input": {
          "type": "boolean"
        },
        "ooc": {
          "type": "boolean"
        },
        "timed_choices": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "format": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$",
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "narrator": {
      "additionalProperties": true,
      "properties": {
        "instructions": {
          "type": "string"
        },
        "length": {
          "type": "string"
        },
        "reasoning": {
          "enum": [
            "off",
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "new_game": {
      "additionalProperties": true,
      "properties": {
        "fields": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "default": {},
              "hint": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "max": {
                "type": "number"
              },
              "max_length": {
                "type": "integer"
              },
              "min": {
                "type": "number"
              },
              "options": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "enum": [
                  "text",
                  "textarea",
                  "number",
                  "select",
                  "multiselect",
                  "toggle"
                ],
                "type": "string"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "openings": {
      "items": {
        "additionalProperties": true,
        "if": {
          "properties": {
            "mode": {
              "const": "static"
            }
          }
        },
        "properties": {
          "description": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "initial_state": {
            "additionalProperties": {},
            "type": "object"
          },
          "mode": {
            "enum": [
              "static",
              "generate"
            ],
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "mode"
        ],
        "then": {
          "properties": {
            "file": {
              "minLength": 1
            }
          },
          "required": [
            "file"
          ]
        },
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "presentation": {
      "additionalProperties": true,
      "properties": {
        "dialogue": {
          "enum": [
            "plain",
            "tagged"
          ],
          "type": "string"
        },
        "stage": {
          "type": "boolean"
        },
        "text_effects": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "requires": {
      "additionalProperties": true,
      "properties": {
        "vision": {
          "enum": [
            "none",
            "preferred",
            "required"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "subtitle": {
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "title",
    "openings"
  ],
  "title": "AINT 作品：work",
  "type": "object"
}
